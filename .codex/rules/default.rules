# Project command allowlist for Codex.
# Matching commands may run outside the sandbox without prompting.
prefix_rule(pattern = ["sudo", "apt", "install"], decision = "allow")
prefix_rule(pattern = ["sudo", "apt", "update"], decision = "allow")
prefix_rule(pattern = ["python3"], decision = "allow")
prefix_rule(pattern = [".venv/bin/python3"], decision = "allow")
prefix_rule(pattern = [".venv/bin/pytest"], decision = "allow")
prefix_rule(pattern = ["uv"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["curl"], decision = "allow")
